API_PREFIX=/api/v1
SERVICE_PORT=8080

DB_USER=postgres
DB_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
DB_NAME=app
DB_HOST=db
DB_PORT=5432

JWT_SECRET=change-me
JWT_TTL_HOURS=720

CODE_TTL_SECONDS=600
CODE_RESEND_SECONDS=30

# console just logs the code to stdout — good for local dev.
# switch to smtp and fill in the SMTP_* vars to actually send email.
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@awebo.example

# Куда сохранять загруженные файлы (аватары) и лимит размера в МБ.
# Отдаётся статикой по /uploads/*. В docker-compose примонтирован как volume.
UPLOADS_DIR=uploads
MAX_AVATAR_SIZE_MB=5
